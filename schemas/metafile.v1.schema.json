{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wellmanifest.org/schemas/metafile/v1.json",
  "title": "Wellmanifest Metafile v1 Schema",
  "description": "Canonical schema for self-contained document and file embedded metadata.",
  "type": "object",
  "required": [
    "schema",
    "docId"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "wellmanifest.metafile/v1"
    },
    "docId": {
      "type": "string",
      "description": "Unique, deterministic identifier for this document artifact.",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "urn": {
      "type": "string",
      "description": "Canonical Uniform Resource Name for routing and referencing.",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "description": "Business or functional type (e.g., faktura, paragon, wyciag, umowa, invoice, receipt, photo)."
    },
    "date": {
      "type": "string",
      "description": "Effective business date (YYYY-MM-DD or ISO 8601 timestamp)."
    },
    "currency": {
      "type": "string",
      "description": "Standard ISO 4217 three-letter currency code (e.g. PLN, EUR, USD, GBP, CHF).",
      "pattern": "^[A-Z]{3}$",
      "default": "PLN"
    },
    "location": {
      "type": "object",
      "description": "Geographical and physical/network location context.",
      "properties": {
        "country": { "type": "string", "description": "ISO 3166-1 alpha-2 country code (e.g. PL, DE, US)" },
        "city": { "type": "string", "description": "City or municipality (e.g. Szemud, Wejherowo, Gdańsk, Warszawa)" },
        "address": { "type": "string", "description": "Street name, building number, postal code" },
        "postalCode": { "type": "string", "description": "Postal / ZIP code (e.g. 84-217)" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "placeName": { "type": "string", "description": "Place or venue name (e.g. Stacja Paliw, Sklep, Biuro)" },
        "node": { "type": "string", "description": "Distributed node identifier (e.g. lenovo, nvidia, laptop)" },
        "storagePath": { "type": "string", "description": "Canonical filesystem storage location" }
      },
      "additionalProperties": true
    },
    "title": {
      "type": "string",
      "description": "Human-readable title or subject."
    },
    "description": {
      "type": "string",
      "description": "Extended description or summary of document contents."
    },
    "accounting": {
      "type": "object",
      "description": "Financial and accounting classification metadata.",
      "properties": {
        "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{2})?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "PLN" },
        "exchangeRate": { "type": "number", "description": "Exchange rate to base currency if foreign" },
        "netAmount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{2})?$" },
        "vatAmount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{2})?$" },
        "grossAmount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{2})?$" },
        "contractor": { "type": "string" },
        "contractorNip": { "type": "string" },
        "buyer": { "type": "string" },
        "buyerNip": { "type": "string" },
        "iban": { "type": "string" },
        "period": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}$" },
        "category": { "type": "string", "enum": ["koszty", "przychody", "bank", "email", "umowy", "inne"] },
        "subfolder": { "type": "string" },
        "invoiceNumber": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "description": "Cryptographic and perceptual integrity digests.",
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "textSha256": { "type": "string" },
        "dhash": { "type": "string" },
        "phash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ocr": {
      "type": "object",
      "description": "Optical Character Recognition results.",
      "properties": {
        "backend": { "type": "string" },
        "chars": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "description": "Lifecycle audit trail and origins.",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "stagedAt": { "type": "string", "format": "date-time" },
        "routedAt": { "type": "string", "format": "date-time" },
        "deviceId": { "type": "string" },
        "seriesId": { "type": "string" },
        "host": { "type": "string" },
        "sourcePath": { "type": "string" },
        "originalFilename": { "type": "string" }
      },
      "additionalProperties": true
    },
    "extra": {
      "type": "object",
      "description": "Unconstrained custom extensions and application-specific metadata.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
